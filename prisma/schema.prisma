// use prisma-8

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Product {
  id          Int      @id @default(autoincrement())
  number      Int      @unique
  name        String
  family      String
  short       String?
  description String?
  image       String?
  tag         String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  benefits    ProductBenefit[]
  enquiries   ProductEnquiry[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model ProductBenefit {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  text      String
  sortOrder Int      @default(0)

  createdAt   TimestamptzString @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  location    String?
  industry    String?
  description String?
  image       String?
  category    String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  images      ProjectImage[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model ProjectImage {
  id        Int      @id @default(autoincrement())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId Int
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)

  createdAt   TimestamptzString @default(now())
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  logo        String?
  sector      String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Enquiry {
  id                    Int            @id @default(autoincrement())
  name                  String
  company               String?
  email                 String?
  phone                 String?

  facilityType          String?
  flooringArea          String?
  projectRequirement    String?
  projectStartTimeline  String?
  projectRole           String?
  projectCity           String?

  message               String?
  source                EnquirySource  @default(WEBSITE)
  status                EnquiryStatus  @default(NEW)

  productEnquiries      ProductEnquiry[]

  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()
}

model ProductEnquiry {
  id         Int      @id @default(autoincrement())
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id])
  enquiryId  Int
  product    Product  @relation(fields: [productId], references: [id])
  productId Int

  createdAt  TimestamptzString @default(now())
}

model ARFlooringSystem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  options     ARFlooringOption[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model ARFlooringOption {
  id          Int      @id @default(autoincrement())
  system      ARFlooringSystem @relation(fields: [systemId], references: [id])
  systemId    Int
  name        String
  color       String?
  texture     String?
  previewUrl  String?
  sortOrder   Int      @default(0)

  createdAt   TimestamptzString @default(now())
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum EnquirySource {
  WEBSITE
  PRODUCT
  CONTACT
  AR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  QUOTATION
  NEGOTIATION
  WON
  LOST
}